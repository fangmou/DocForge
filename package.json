{
  "name": "docforge",
  "version": "0.1.0",
  "description": "AI 原生、可扩展的本地文本编辑器 — 为思想工程师而造",
  "license": "GPL-3.0-or-later",
  "author": "Fangmou <iaming@me.com> (https://github.com/fangmou)",
  "homepage": "http://www.fangmou.com/docforge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangmou/DocForge.git"
  },
  "bugs": {
    "url": "https://github.com/fangmou/DocForge/issues"
  },
  "keywords": [
    "asciidoc",
    "markdown",
    "editor",
    "ai",
    "tauri",
    "lit",
    "knowledge-graph",
    "desktop"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "vite build && size-limit && node scripts/eager-graph.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.8",
    "@replit/codemirror-vim": "^6.3.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.2",
    "@tauri-apps/plugin-fs": "^2.3.0",
    "lit": "^3.3.0",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "@size-limit/file": "^12.1.0",
    "@tauri-apps/cli": "^2.5.0",
    "knip": "^6.16.1",
    "size-limit": "^12.1.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  }
}
